  "description": "Video studio: da un prompt in italiano a un MP4 verificato per MatrimonioSemplice",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "make": "node cli/index.ts make",
    "preview": "node cli/index.ts preview",
