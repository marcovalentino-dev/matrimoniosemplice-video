{
  "$description": "Design token MatrimonioSemplice per i video. Fonte: brand/03_DESIGN_SYSTEM.md. Non modificare i valori senza aggiornare prima la fonte.",
  "color": {
    "cream":        { "value": "#FFF8F5", "role": "Sfondo primario" },
    "parchment":    { "value": "#F3ECE8", "role": "Sfondo alternato" },
    "blush":        { "value": "#E8B4B8", "role": "Accento primario: bottoni, highlight" },
    "blushLight":   { "value": "#FEF0F1", "role": "Sfondo badge e tag" },
    "rose":         { "value": "#D8A7B1", "role": "Accento hover / secondario" },
    "champagne":    { "value": "#7A5C38", "role": "Oro: eyebrow, dettagli (mai dominante)" },
    "goldLight":    { "value": "#D4B896", "role": "Decorazioni, illustrazioni" },
    "goldPale":     { "value": "#F0E8E0", "role": "Sfondi caldi delicati" },
    "border":       { "value": "#EFEAE7", "role": "Bordi, divisori" },
    "white":        { "value": "#FFFFFF", "role": "Card, superfici elevate" },
    "ink":          { "value": "#1E1E1E", "role": "Testo primario. Sostituisce SEMPRE il nero puro" },
    "muted":        { "value": "#4A4A4A", "role": "Testo secondario" },
    "subtle":       { "value": "#666666", "role": "Testo terziario" }
  },
  "forbidden": {
    "colors": ["#000000"],
    "note": "Mai nero puro: usare color.ink. Blush non come sfondo di testo piccolo. Max 2–3 colori per layout."
  },
  "gradient": {
    "shimmer":   { "angle": 90,  "stops": ["#D8A7B1", "#E8B4B8", "#C6A27E", "#E8B4B8", "#D8A7B1"], "use": "Testo headline premium" },
    "coverHero": { "angle": 160, "stops": ["#F9EEF2", "#FFF8F5", "#F3ECE8", "#EDE4DF"], "use": "Sfondo hero di default" }
  },
  "orb": {
    "blush":   { "color": "rgba(232,180,184,0.20)", "position": "alto sinistra" },
    "rose":    { "color": "rgba(216,167,177,0.16)", "position": "basso destra" },
    "warm":    { "color": "rgba(198,162,126,0.12)", "position": "centro destra" }
  },
  "theme": {
    "roseRomantico": { "bg": "#FFF8F5", "bgAlt": "#F3ECE8", "accent": "#E8B4B8", "accentHover": "#D8A7B1", "luxury": "#7A5C38", "default": true },
    "avorioClassico": { "bg": "#FEFCF8", "bgAlt": "#F5EFE6", "accent": "#C9A96E", "accentHover": "#B8935A", "luxury": "#8B6914" },
    "verdeSalvia":    { "bg": "#F5F8F4", "bgAlt": "#EAF0E8", "accent": "#7A9E76", "accentHover": "#5E7A5A", "luxury": "#5E7535" },
    "bluSera":        { "bg": "#F4F6FA", "bgAlt": "#EBF0F8", "accent": "#7A94C4", "accentHover": "#5A78B0", "luxury": "#4A6094" },
    "terraBruciata":  { "bg": "#FAF6F2", "bgAlt": "#EFE6DC", "accent": "#C4785A", "accentHover": "#A85E46", "luxury": "#7A4E38" }
  },
  "font": {
    "maxPerComposition": 2,
    "heading": {
      "family": "Playfair Display",
      "fallback": "Georgia, serif",
      "weights": [400, 600, 700],
      "styles": ["normal", "italic"]
    },
    "body": {
      "family": "Inter",
      "fallback": "system-ui, sans-serif",
      "weights": [400, 500, 600],
      "styles": ["normal"]
    },
    "alternatives": {
      "note": "Solo per siti matrimonio a tema; non usare nei video di brand.",
      "list": ["Cormorant Garamond", "EB Garamond", "DM Serif Display", "Josefin Sans"]
    }
  },
  "type": {
    "displayLarge": { "font": "heading", "size": 88, "note": "Hero headline" },
    "displaySmall": { "font": "heading", "size": 56, "note": "Titoli sezione" },
    "h3":           { "font": "heading", "size": 32, "sizeMin": 24, "note": "Sottotitoli, card title" },
    "eyebrow":      { "font": "body", "size": 12, "weight": 600, "uppercase": true, "letterSpacing": "0.18em", "color": "champagne" },
    "body":         { "font": "body", "size": 16, "weight": 400, "lineHeight": 1.6 },
    "bodySmall":    { "font": "body", "size": 14, "weight": 400, "lineHeight": 1.5 },
    "label":        { "font": "body", "size": 12, "weight": 500, "uppercase": true },
    "button":       { "font": "body", "size": 14, "weight": 600, "letterSpacing": "0.04em" },
    "lineHeightRange": [1.5, 1.65]
  },
  "radius": {
    "pill": 9999,
    "card": 20,
    "input": 12,
    "badge": 8,
    "badgeMin": 6
  },
  "shadow": {
    "soft":    "0 2px 16px rgba(0,0,0,0.04)",
    "softMd":  "0 4px 24px rgba(0,0,0,0.06)",
    "softLg":  "0 8px 40px rgba(0,0,0,0.08)",
    "blush":   "0 4px 20px rgba(232,180,184,0.30)",
    "blushLg": "0 12px 40px rgba(232,180,184,0.22)"
  },
  "texture": {
    "grain":      { "opacity": 0.018, "effect": "Film grain, rumore fine" },
    "linen":      { "opacity": 0.06,  "effect": "Trama tessuto" },
    "watercolor": { "opacity": 0.048, "effect": "Rumore a bassa frequenza" },
    "petals":     { "opacity": 0.055, "effect": "Petali rosa sparsi" }
  },
  "component": {
    "buttonPrimary": {
      "background": "blush", "color": "ink", "radius": "pill",
      "font": "type.button", "hoverBackground": "rose", "hoverShadow": "shadow.blush"
    },
    "buttonSecondary": {
      "background": "transparent", "border": "1.5px solid #E8B4B8", "color": "ink",
      "radius": "pill", "font": "type.button", "hoverBackground": "blush"
    },
    "card": {
      "background": "white", "border": "1px solid #EFEAE7", "radius": "card",
      "shadow": "shadow.soft", "overlay": "rgba(232,180,184,0.07)", "overlayPosition": "alto sinistra"
    },
    "eyebrow": { "style": "type.eyebrow" }
  },
  "spacing": {
    "note": "Il design system NON definisce una scala di spaziature in px. Valori documentati sotto; la scala per il video è nelle domande aperte di BRAND_VIDEO.md.",
    "documented": {
      "lineHeightBody": [1.5, 1.65],
      "letterSpacingButton": "0.04em",
      "letterSpacingEyebrow": "0.18em",
      "radiusCard": 20,
      "radiusInput": 12,
      "radiusBadge": [6, 8]
    },
    "principle": "Molto spazio bianco: il brand respira, non è affollato."
  },
  "rules": {
    "do": [
      "Titoli in Playfair Display (anche corsivo per un tocco romantico)",
      "Sfondo base cream #FFF8F5",
      "Blush #E8B4B8 come accento per CTA ed elementi chiave",
      "Champagne #7A5C38 solo come dettaglio, mai dominante",
      "Lasciare spazio bianco",
      "Bottoni a pillola"
    ],
    "dont": [
      "Nero puro #000000: usare #1E1E1E",
      "Font geometrici freddi (es. Futura, Helvetica) come heading",
      "Più di 2–3 colori per layout",
      "Blush come sfondo di testo piccolo (contrasto insufficiente)",
      "Più di 2 font nella stessa composizione"
    ],
    "maxColorsPerLayout": 3,
    "maxFontsPerComposition": 2
  }
}
